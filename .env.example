# ==============================================================================
# TrustVault - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit .env or actual production credentials to version control.
# - Keep .env excluded via .gitignore.
# ==============================================================================

# Database Connection (Individual properties)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trustvault
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Alternatively, set full Spring Datasource URL (takes precedence if set)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/trustvault
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# Database Pool Settings
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2

# JPA / Hibernate DDL behavior (validate | update | none)
JPA_DDL_AUTO=validate
JPA_FORMAT_SQL=false
SHOW_SQL=false

# Server Port
PORT=8080

# Private Storage Location (MUST NOT be inside static web folders)
STORAGE_UPLOAD_DIR=./private-storage/uploads
